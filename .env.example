# QR Security Engine — Environment Configuration Template
# Copy to .env for environment-specific configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security Rules Configuration
RULES_CONFIG_PATH=config/security_rules.json
TLD_CONFIG_PATH=config/tld_risk.json
SHORTENER_CONFIG_PATH=config/url_shorteners.json
FUSION_CONFIG_PATH=config/risk_fusion.json

# Model Artifact Paths
URL_MODEL_PATH=model/qr_url_model.pkl
UPI_MODEL_PATH=model/qr_upi_model.pkl
